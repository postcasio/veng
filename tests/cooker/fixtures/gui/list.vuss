/* A selectable track list: the row is a composite item (text + art + a button), and `:selected`
   scopes the row's fill the way `:hover` scopes any other element's. */

.screen {
    width: 100%;
    height: 100%;
}

.track-list {
    flex-direction: column;
}

.row {
    flex-direction: row;
    height: 32px;
    background: #202020ff;
}

.row:hover {
    background: #303030ff;
}

.row:selected {
    background: #2266ccff;
    color: #ffffffff;
}

/* The scrollable list view and its widget-owned bars: the parts are ordinary elements, so they
   style through plain type/class selectors and pseudo-state variants. */

.track-list {
    overflow-x: hidden;
    overflow-y: scroll;
    scrollbar: gutter;
}

ScrollBar {
    background: #00000040;
}

ScrollBar.vertical {
    width: 8px;
}

ScrollBarThumb {
    background: #ffffff60;
    corner-radius: 4px;
}

ScrollBarThumb:hover {
    background: #ffffffa0;
}
