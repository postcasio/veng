/* A small HUD stylesheet exercising type/class/id selectors and pseudo-states. */

.hud {
    flex-direction: column;
    background: #1a1a1acc;
    padding: 8px;
}

.primary {
    background: #3b82f6;
    corner-radius: 4px;
    color: #ffffff;
}

.primary:hover {
    background: #60a5fa;
}

.primary:disabled {
    opacity: 0.5;
}

Text#title {
    font-size: 24px;
    color: #eaeaeaff;
}

/* A cursor-following tag: hit-transparent, anchored from the bottom-right, pulsing. */
@keyframes tag-pulse {
    from { opacity: 0.2; }
    50% { opacity: 1.0; }
    to { opacity: 0.2; }
}

.tag {
    position: absolute;
    inset-right: 12;
    inset-bottom: 8;
    pointer-events: none;
    origin: 0.5 0.5;
    animation: tag-pulse 2s ping-pong;
}
