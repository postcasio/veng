.DS_Store
/build/
/build-debug/
/build-debug-off/
.idea
imgui.ini

# Per-project editor sidecar: the build records its output dir here for the editor to discover.
# Machine-local (absolute build paths), written beside each project's project.veng.
.veng/

# Editor scratch files written beside an asset while editing (e.g. *.editor-tmp.vmat.json).
*.editor-tmp*

# Coverage build tree (VENG_ENABLE_COVERAGE) and its gcovr reports.
/build-coverage/

# Compile-time tracing build tree (VENG_TIME_TRACE): objects plus a per-TU .json beside
# each of them, gigabytes of it, embedding absolute developer paths.
/build-trace*/

# Python bytecode cache, written beside the scripts by any script run.
__pycache__/
