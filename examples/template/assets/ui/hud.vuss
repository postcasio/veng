/* Minimal HUD stylesheet: a translucent panel pinned to a corner, a title, and a value bar. */

.hud {
    flex-direction: column;
    background: #12141acc;
    corner-radius: 6px;
    padding: 12px;
}

/* Logo badge: a cooked UI texture, framed by a rounded border to show Image composing with
   corner-radius and a border like any styled box. */
.badge {
    width: 48px;
    height: 48px;
    corner-radius: 10px;
    border-width: 2px;
    border-color: #2a6df4ff;
    margin: 2px;
}

.title {
    font-size: 22px;
    color: #f2f4f8ff;
}

.caption {
    font-size: 14px;
    color: #9aa3b2ff;
    margin: 4px;
}

.bar {
    height: 8px;
    margin: 6px;
    background: #2a6df4;
    corner-radius: 3px;
}
