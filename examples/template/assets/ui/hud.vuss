/* Minimal HUD stylesheet: a small palette hoisted to file-scope variables, then a translucent
   panel, a framed badge, a title, and a value bar drawing every color from those tokens. The
   accent is defined once and read by two rules — edit it here and both the badge frame and the
   value bar move together. */

--panel: #12141acc;
--accent: #2a6df4;
--text: #f2f4f8ff;
--text-dim: #9aa3b2ff;

.hud {
    flex-direction: column;
    background: var(--panel);
    corner-radius: 6px;
    padding: 12px;
}

/* Logo badge: a cooked UI texture, framed by a rounded border to show Image composing with
   corner-radius and a border like any styled box. */
.badge {
    width: 48px;
    height: 48px;
    corner-radius: 10px;
    border-width: 2px;
    border-color: var(--accent);
    margin: 2px;
}

.title {
    font-size: 22px;
    color: var(--text);
}

.caption {
    font-size: 14px;
    color: var(--text-dim);
    margin: 4px;
}

.bar {
    height: 8px;
    margin: 6px;
    background: var(--accent);
    corner-radius: 3px;
}
