/* The overlay level's own HUD stylesheet: a small opaque card with a heading, a snapshot line, a
   value bar, and a dismiss button. Screen-space UI is LDR (composited after tonemap), so its colors
   are ordinary sRGB hex — unlike the diegetic panel's rgb() HDR emitters, an overlay color clamps at
   white and does not glow. The button carries :hover / :active variants the runtime eases between. */

--card: #161a24f2;
--accent: #f4a52a;
--text: #f2f4f8ff;
--text-dim: #9aa3b2ff;

.overlay {
    flex-direction: column;
    background: var(--card);
    corner-radius: 8px;
    padding: 16px;
    width: 320px;
    margin: 24px;
}

.heading {
    font-size: 22px;
    color: var(--text);
}

.snap {
    font-size: 14px;
    color: var(--text-dim);
    margin: 6px;
}

.bar {
    height: 8px;
    margin: 6px;
    background: var(--accent);
    corner-radius: 3px;
}

.dismiss {
    margin: 8px;
    padding: 8px;
    corner-radius: 5px;
    background: var(--accent);
    color: #10131aff;
    font-size: 16px;
}

.dismiss:hover {
    background: #ffbe4dff;
}

.dismiss:active {
    background: #d98e12ff;
}
