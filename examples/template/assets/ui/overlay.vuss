/* The overlay level's own HUD stylesheet: a small opaque card with a heading, a snapshot line, a
   value bar, and a dismiss button, dropped onto the scene with a soft shadow. Screen-space UI is LDR (composited after tonemap), so its colors
   are ordinary sRGB hex — unlike the diegetic panel's rgb() HDR emitters, an overlay color clamps at
   white and does not glow. The button carries :hover / :active variants the runtime eases between. */

--card: #161a24f2;
--accent: #f4a52a;
--text: #f2f4f8ff;
--text-dim: #9aa3b2ff;

.overlay {
    flex-direction: column;
    background: var(--card);
    corner-radius: 8px;
    box-shadow: 0 6px 18px 0 #00000099;
    padding: 16px;
    width: 320px;
    margin: 24px;
}

/* A plain textured background fill: the badge texture aspect-fitted into the crest's padding box.
   The stylesheet's `background-image` makes the texture a load-time dependency of the sheet, so the
   instantiate-time resolve is a cache hit exactly as a `font` declaration's is. */
.crest {
    width: 48px;
    height: 48px;
    align-self: center;
    background-image: 0x502E61AE5D720E64;
    background-fit: contain;
}

.heading {
    font-size: 22px;
    color: var(--text);
}

.snap {
    font-size: 14px;
    color: var(--text-dim);
    margin: 6px;
}

.bar {
    height: 8px;
    margin: 6px;
    background: var(--accent);
    corner-radius: 3px;
}

.dismiss {
    text-align: center;
    margin: 8px;
    padding: 8px;
    corner-radius: 5px;
    background: var(--accent);
    color: #10131aff;
    font-size: 16px;
}

.dismiss:hover {
    background: #ffbe4dff;
}

.dismiss:active {
    background: #d98e12ff;
}
