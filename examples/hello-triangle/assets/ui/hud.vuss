/* The hello-triangle status HUD: an accent token shared between the stylesheet and the app,
   a nine-slice window-chrome frame behind the panel and a soft drop shadow lifting it off the
   scene, a conic-gradient loading spinner spun by a rotation keyframe, and a fixed strip of
   numbered ticks the app resolves by class and lights per frame. */

--accent: #4fa3ff;
--text: #eef2f8ff;
--tick-idle: #43506688;

/* The frame art is 24×24 with 8px margins, so the corner brackets keep their size at any panel
   width while the edges and the fill stretch. A sliced fill takes no corner-radius — the art
   carries its own corners. Fill sources are exclusive, so this replaces the flat `background`
   rather than layering over it. */
.hud {
    flex-direction: column;
    background-image: 0x2B62E4E91B4A08B4;
    background-slice: 8px;
    box-shadow: 3px 5px 12px 0 #00000099;
    padding: 14px;
    width: 220px;
}

/* The header strip's fill is an authored GuiFill *material* — the top of the exclusive fill-source
   order, so it is the fill and nothing layers under it. The shader owns the color it emits; the
   engine still owns the silhouette, so the corner radius and the enclosing clip compose with it,
   and its sweep animates off the pass clock with no per-frame code here. */
.header {
    flex-direction: row;
    align-items: center;
    corner-radius: 6px;
    padding: 4px 6px 4px 6px;
    background-material: 0x2585BF3D75DE0CEE;
}

.title {
    font-size: 20px;
    color: var(--text);
    margin: 0 0 0 10px;
}

/* A conic ramp from the accent to transparent, painted on a circular box and spun about its
   center by the `spin` keyframe — the rotation turns the whole subtree rigidly, so the gradient
   sweeps like a classic loading arc. */
.spinner {
    width: 22px;
    height: 22px;
    corner-radius: 11px;
    origin: 0.5 0.5;
    background-gradient: conic from 0deg at 50% 50%, var(--accent) 0%, #12141a00 100%;
    animation: spin 1s loop;
}

@keyframes spin {
    from { rotation: 0; }
    to { rotation: 360; }
}

.ticks {
    flex-direction: row;
    margin: 12px 0 0 0;
}

/* One numbered tick; `count` replicates it, `${n:02}` fills the label 01..08. The app resolves
   the whole pool by class and drives each tick's color, so the markup carries no ids. */
.tick {
    font-size: 13px;
    color: var(--tick-idle);
    margin: 0 6px 0 0;
}

/* A reserved strip the app pins its channel caption into. The slot fixes the space; the caption
   inside it declares no width, so it is exactly as wide as the label it carries. */
.readout {
    height: 17px;
    margin: 6px 0 0 0;
}

/* A short scrolling strip of channel rows, deliberately too small to hold all six: clicking a row
   opens a dropdown from the driver into the document's popup layer, which lays out against the
   document extent and paints with no inherited scissor — so the menu covers the rows below it and
   spills past this box, where an absolute-positioned child would be clipped away by it. */
.picker {
    height: 54px;
    margin: 10px 0 0 0;
    padding: 3px;
    corner-radius: 4px;
    background: #12141a99;
}

.row {
    font-size: 13px;
    color: var(--text);
    padding: 2px 4px 2px 4px;
    margin: 0 0 2px 0;
    corner-radius: 3px;
    background: #43506644;
}

.row:hover {
    background: #4fa3ff44;
}

/* A legend strip of the four ways an <Image> maps its texture into its content box. */
.legend {
    flex-direction: row;
    align-items: flex-start;
    margin: 10px 0 0 0;
}

/* The same 24×24 frame art the panel uses, sliced: the corners hold while the box stretches. */
.chip {
    width: 66px;
    height: 20px;
    image-slice: 8px;
}

/* No authored size at all — the element takes the texture's own 24×24 pixels. */
.glyph {
    margin: 0 0 0 6px;
}

/* An 8×8 hatch repeated by its own wrapping sampler: one quad, whatever the box's size. */
.swatch {
    width: 40px;
    height: 24px;
    margin: 0 0 0 6px;
    image-repeat: tile;
}

/* A square texture in a wide box, and the second material host: an <Image> shading its own `src`
   art through a GuiFill material. The texture reaches the shader as a declared parameter, so the
   wipe recolors the authored pixels rather than replacing them — the widget-side spelling is
   `material`, not `background-material`, and it supersedes the plain fit-into-the-box fill. */
.thumb {
    width: 40px;
    height: 24px;
    margin: 0 0 0 6px;
    object-fit: contain;
    material: 0x106ABE559B6AE349;
}
