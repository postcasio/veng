/* The hello-triangle status HUD: an accent token shared between the stylesheet and the app,
   a nine-slice window-chrome frame behind the panel and a soft drop shadow lifting it off the
   scene, a conic-gradient loading spinner spun by a rotation keyframe, and a fixed strip of
   numbered ticks the app resolves by class and lights per frame. */

--accent: #4fa3ff;
--text: #eef2f8ff;
--tick-idle: #43506688;

/* The frame art is 24×24 with 8px margins, so the corner brackets keep their size at any panel
   width while the edges and the fill stretch. A sliced fill takes no corner-radius — the art
   carries its own corners. Fill sources are exclusive, so this replaces the flat `background`
   rather than layering over it. */
.hud {
    flex-direction: column;
    background-image: 0x2B62E4E91B4A08B4;
    background-slice: 8px;
    box-shadow: 3px 5px 12px 0 #00000099;
    padding: 14px;
    width: 220px;
}

.header {
    flex-direction: row;
    align-items: center;
}

.title {
    font-size: 20px;
    color: var(--text);
    margin: 0 0 0 10px;
}

/* A conic ramp from the accent to transparent, painted on a circular box and spun about its
   center by the `spin` keyframe — the rotation turns the whole subtree rigidly, so the gradient
   sweeps like a classic loading arc. */
.spinner {
    width: 22px;
    height: 22px;
    corner-radius: 11px;
    origin: 0.5 0.5;
    background-gradient: conic from 0deg at 50% 50%, var(--accent) 0%, #12141a00 100%;
    animation: spin 1s loop;
}

@keyframes spin {
    from { rotation: 0; }
    to { rotation: 360; }
}

.ticks {
    flex-direction: row;
    margin: 12px 0 0 0;
}

/* One numbered tick; `count` replicates it, `${n:02}` fills the label 01..08. The app resolves
   the whole pool by class and drives each tick's color, so the markup carries no ids. */
.tick {
    font-size: 13px;
    color: var(--tick-idle);
    margin: 0 6px 0 0;
}

/* A legend strip of the four ways an <Image> maps its texture into its content box. */
.legend {
    flex-direction: row;
    align-items: flex-start;
    margin: 10px 0 0 0;
}

/* The same 24×24 frame art the panel uses, sliced: the corners hold while the box stretches. */
.chip {
    width: 66px;
    height: 20px;
    image-slice: 8px;
}

/* No authored size at all — the element takes the texture's own 24×24 pixels. */
.glyph {
    margin: 0 0 0 6px;
}

/* An 8×8 hatch repeated by its own wrapping sampler: one quad, whatever the box's size. */
.swatch {
    width: 40px;
    height: 24px;
    margin: 0 0 0 6px;
    image-repeat: tile;
}

/* A square texture in a wide box, letterboxed rather than stretched. */
.thumb {
    width: 40px;
    height: 24px;
    margin: 0 0 0 6px;
    object-fit: contain;
}
